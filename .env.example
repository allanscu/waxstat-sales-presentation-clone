# Builder login password. Leave PASSWORD or SESSION_SECRET unset and the gate
# opens — handy locally, so a missing env var can't lock anyone out.
PASSWORD=your-local-password

# HMAC secret for signing the session cookie (any long random string).
SESSION_SECRET=generate-a-long-random-hex-string

# Optional Postgres (Neon) for saved decks. Without it the app still runs —
# decks just save to the browser instead of a shared database.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
